<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinRT>true</UseWinRT>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.0.0</Version>
    <AssemblyTitle>PikaSpace Windows Companion</AssemblyTitle>
    <Product>PikaSpace Windows Companion</Product>
    <Company>PikaSpace</Company>
    <Title>PikaSpace Windows Companion</Title>
    <Description>On-demand local media and system metrics for PikaSpace.</Description>
  </PropertyGroup>
</Project>
